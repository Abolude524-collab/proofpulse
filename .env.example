# ProofPulse Environment Variables

# 1. Google Gemini API Key (Required for live Gemma analysis)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Configured Gemma Model
# Default is gemma-4-26b-a4b-it (Gemma 4 MoE 26B/4B active)
GEMMA_MODEL=gemma-4-26b-a4b-it

# 3. Search Provider
# Options:
# - gemini-grounding : Attempts Google Search grounding tool via Gemini API (note: Gemma models currently reject tools on Gemini API)
# - duckduckgo       : Live web search without requiring a separate API key
# - tavily           : High quality AI search API (requires SEARCH_API_KEY)
# - brave            : Brave Web Search API (requires SEARCH_API_KEY)
SEARCH_PROVIDER=duckduckgo

# 4. Search API Key (Only required if SEARCH_PROVIDER is set to tavily or brave)
SEARCH_API_KEY=
